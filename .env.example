# --- App ---
# En producción el servidor se niega a arrancar si estas variables faltan, son de ejemplo o apuntan a localhost (ver docs/DEPLOY.md).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=server-only-secret
APPLICATION_BASE_URL=http://localhost:3000
CRON_SECRET=long-random-string-for-/api/cron/expire   # openssl rand -hex 32

# --- Bold (Colombia, COP). Keys: panel Bold > Integraciones > Llaves de integración (usa las de prueba en sandbox; ambas del mismo ambiente) ---
BOLD_IDENTITY_KEY=xxx                # llave de identidad (pública): lee pagos y se muestra en el botón
BOLD_SECRET_KEY=xxx                  # server only: firma el checkout (hash de integridad) y verifica webhooks
# Webhook: https://TU_DOMINIO/api/webhooks/bold (panel Bold > Integraciones > Webhooks). Bold no envía webhooks en sandbox.

# --- Wompi (heredado; ya no se ofrece en la interfaz, solo liquida pagos anteriores) ---
# --- Wompi (Colombia, COP). Keys: dashboard Wompi > Desarrolladores ---
WOMPI_ENVIRONMENT=sandbox            # sandbox | production
WOMPI_PUBLIC_KEY=pub_test_xxx
WOMPI_PRIVATE_KEY=prv_test_xxx       # server only: reads transactions
WOMPI_EVENTS_SECRET=test_events_xxx  # server only: verifies webhooks
WOMPI_INTEGRITY_SECRET=test_integrity_xxx   # server only: signs checkouts

FX_WARN_HOURS=24                     # avisa al operador cuando falten ≤ 24 h para que la tasa venza (1–167)
ADMIN_ALERT_WEBHOOK_URL=             # webhook https (Slack/Discord/…) donde el operador recibe los avisos; vacío = solo /api/health y logs
# --- Marketing (/staff/marketing). Cada canal se activa solo si están TODAS sus variables ---
VAPID_PUBLIC_KEY=                    # push web: npx web-push generate-vapid-keys (la pública no es secreta; la privada sí)
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@rutinia.company
EMAIL_PROVIDER=                      # resend (docs/EMAIL.md); vacío = el canal de correo queda apagado
RESEND_API_KEY=
EMAIL_FROM=Rutinia <no-responder@rutinia.company>
GOOGLE_SIGNIN=                       # "on" muestra «Continuar con Google» en el login y el registro; actívalo solo después de habilitar Google en Supabase Auth (docs/AUTH.md)
SUPPORT_ALERT_WEBHOOK_URL=             # Slack/Discord (https): aviso al equipo cuando un entrenador escribe a soporte (sin el texto del mensaje). Si falta, se usa ADMIN_ALERT_WEBHOOK_URL
FX_MONITORING=                       # "on" solo si quieres vigilar la tasa USD→COP (los precios en pesos de Wompi son fijos y ya no la usan)
FX_MAX_AGE_HOURS=168                 # tasa USD→COP más vieja que esto pausa los cobros nuevos de Wompi (1–1440; por defecto 168 = 7 días)

# --- PayPal (USD). Keys: developer.paypal.com > Apps & Credentials ---
PAYPAL_ENVIRONMENT=sandbox           # sandbox | production
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=                # server only
PAYPAL_WEBHOOK_ID=                   # id of the webhook registered for /api/webhooks/paypal
PAYPAL_PLAN_ID=                      # printed by scripts/paypal-setup.mjs

# --- Copiloto de IA (opcional; sin estas variables todo funciona en "Modo sin IA") ---
AI_PROVIDER=                         # anthropic | openai | gemini (vacío = IA apagada)
ANTHROPIC_API_KEY=                   # server only; solo la del proveedor elegido
OPENAI_API_KEY=                      # server only
GEMINI_API_KEY=                      # server only
AI_MODEL=                            # anthropic: por defecto claude-opus-5-5. openai y gemini: obligatorio, nombre exacto del modelo
AI_ENABLED=true                      # "false" = interruptor de apagado
AI_ALLOW_SENSITIVE=false             # operador: permitir enviar contexto de salud minimizado al proveedor
AI_MAX_OUTPUT_TOKENS=4096
AI_TIMEOUT_MS=60000

# --- Abuso de cuentas (opcionales; los valores por defecto son los recomendados) ---
# Límites por ventana, guardados en la base (tabla auth_throttle). Enteros positivos; un valor inválido vuelve al defecto.
# AUTH_LIMIT_SIGNUP_IP=5       # registros por IP y hora        · AUTH_LIMIT_SIGNUP_EMAIL=3  # por correo y día
# AUTH_LIMIT_RESET_IP=8        # solicitudes de enlace por IP/h  · AUTH_LIMIT_RESET_EMAIL=3   # por correo y hora
# AUTH_LIMIT_LOGIN_PAIR=10     # intentos por IP+correo / 15 min · AUTH_LIMIT_LOGIN_IP=60     # por IP / 15 min
# AUTH_LIMIT_CHANGE_USER=6     # cambios de contraseña por usuario / 15 min
# AUTH_MIN_FILL_MS=3000        # un formulario enviado antes de este tiempo se trata como robot
